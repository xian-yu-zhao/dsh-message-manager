{
  "name": "dsh-context-manager",
  "version": "1.6.0",
  "type": "module",
  "description": "Manage a DSH session's model context: delete single messages or whole conversation turns (roll back to the start of any turn, drop noise), and restore them later, without touching the raw session log.",
  "license": "MIT",
  "author": "xian-yu-zhao",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "plugin",
    "session",
    "context",
    "conversation",
    "turn",
    "rollback",
    "prune",
    "tombstone",
    "delete",
    "restore"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xian-yu-zhao/dsh-context-manager.git"
  },
  "homepage": "https://github.com/xian-yu-zhao/dsh-context-manager#readme",
  "bugs": {
    "url": "https://github.com/xian-yu-zhao/dsh-context-manager/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "core.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  }
}
